{
  "name": "PlaidItem",
  "type": "object",
  "properties": {
    "item_id": {
      "type": "string",
      "description": "Plaid item identifier"
    },
    "access_token": {
      "type": "string",
      "description": "Plaid access token (server-side only, never exposed to frontend)"
    },
    "cursor": {
      "type": "string",
      "description": "Transactions sync cursor for incremental /transactions/sync calls"
    },
    "user_id": {
      "type": "string",
      "description": "Associated app user id when the link was created by an authenticated user"
    },
    "client_user_id": {
      "type": "string",
      "description": "Client user id passed to Link token creation"
    },
    "products": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "default": "active"
    }
  },
  "required": [
    "item_id",
    "access_token"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}